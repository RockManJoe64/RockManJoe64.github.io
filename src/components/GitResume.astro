<script>
    import { createGitgraph } from '@gitgraph/js';

    const graphContainer = document.getElementById('gitgraph');
    const gitgraph = createGitgraph(graphContainer);

    const main = gitgraph.branch('main');
    const commitNode = main.commit('Init the project');
    const commitElement = document.getElementById(commitNode.id);
    if (commitElement) {
        commitElement.addEventListener('click', () => {
            console.log('Commit clicked:', commitNode.message);
            // Add your desired behavior here, e.g., open a modal, redirect to a URL
        });
    }
    main.commit('Add README').commit('Add tests').commit('Implement feature');
    main.tag('v1.0');
    const newFeature = gitgraph.branch('new-feature');
    newFeature.commit('Implement an awesome feature');
    main.commit('Hotfix a bug');
    newFeature.commit('Fix tests');
    // Merge `newFeature` into `main`
    main.merge(newFeature, 'Release new version');
</script>

<div>
    <!-- START GitGraph -->
    <div id="gitgraph"></div>
    <!-- END GitGraph -->
</div>
